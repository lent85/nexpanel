# ==============================================================================
# NexPanel Environment Configuration
# ==============================================================================

NODE_ENV=development
PANEL_PORT=8443
PANEL_HOST=0.0.0.0
PANEL_DOMAIN=panel.example.com
PANEL_BASE_URL=https://panel.example.com
PANEL_TIMEZONE=Asia/Bangkok
PANEL_DEFAULT_PHP=8.3
PANEL_DEFAULT_DB_ENGINE=internal-mysql

# Security & Vault (AES-256-GCM)
VAULT_KEY_PATH=./data/panel/vault.key
JWT_SECRET=nexpanel_jwt_secret_change_me_in_production_min32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Panel Metadata Database (PostgreSQL 16)
PANEL_DB_HOST=localhost
PANEL_DB_PORT=5432
PANEL_DB_USER=nexpanel
PANEL_DB_PASSWORD=nexpanel_secret
PANEL_DB_NAME=nexpanel
# Set to true to run fully in-memory without a live PostgreSQL instance (ideal for rapid AI dev & tests)
PANEL_DB_USE_MEMORY=false

# Edge Reverse Proxy (Nginx Proxy Manager 2.16.0 API)
NPM_BASE_URL=http://npm:81
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=changeme
NPM_NETWORK=proxy
NPM_LETSENCRYPT_EMAIL=admin@example.com

# Site & Data Storage
SITES_DATA_DIR=./data/sites
PANEL_DATA_DIR=./data/panel
