# NexPanel — .env.example (REFERENCE ONLY — copy to .env and fill in, chmod 600 .env)
# Never commit a filled-in .env. All secrets here are placeholders.

# --- Panel ---
PANEL_DOMAIN=panel.example.com
PANEL_BASE_URL=https://panel.example.com
PANEL_PORT=8443
PANEL_TIMEZONE=Asia/Bangkok
PANEL_DEFAULT_PHP=8.3
PANEL_DEFAULT_DB_ENGINE=internal-mysql
VAULT_KEY_PATH=/data/panel/vault.key

# --- Panel metadata DB (PostgreSQL, panel only) ---
PANEL_DB_NAME=nexpanel
PANEL_DB_USER=nexpanel
PANEL_DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_32_CHARS
PANEL_DB_HOST=nexpanel-db
PANEL_DB_PORT=5432

# --- Internal MySQL engine (toggleable in Admin -> Database Engines) ---
INTERNAL_MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_RANDOM_32_CHARS
INTERNAL_MYSQL_IMAGE=mysql:8.4

# --- External NPM (R1) ---
# Either the panel manages the `npm` container in compose (Shape A),
# or you point it at an already-running NPM (Shape C).
NPM_BASE_URL=http://npm:81
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM_32_CHARS
NPM_NETWORK=proxy
NPM_LETSENCRYPT_EMAIL=admin@example.com

# --- External DB engines (R2) — examples, fill in only the ones you use ---
# External MySQL Docker (same host, container `external-mysql` on network `sites`):
# EXTERNAL_MYSQL_HOST=external-mysql
# EXTERNAL_MYSQL_PORT=3306
# EXTERNAL_MYSQL_ROOT_USER=root
# EXTERNAL_MYSQL_ROOT_PASSWORD=CHANGE_ME
# Remote MariaDB / RDS:
# REMOTE_DB_HOST=db.example.com
# REMOTE_DB_PORT=3306
# REMOTE_DB_TLS=true

# --- Backups (rclone remote, same providers as CloudPanel) ---
BACKUP_REMOTE_PROVIDER=s3
BACKUP_REMOTE_BUCKET=nexpanel-backups
BACKUP_REMOTE_REGION=ap-southeast-1
# Rclone credentials go in the panel UI (encrypted in the vault), not here.

# --- Mail (external SMTP only — no local mail server) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=panel@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@example.com

# --- Cloudflare (optional, for DNS-01 + purge) ---
# CLOUDFLARE_API_TOKEN=CHANGE_ME
